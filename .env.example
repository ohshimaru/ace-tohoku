# ============================================================
# 経営ナビ（株式会社エースナンバー東北）環境変数の見本
# 実際の値は .env（ローカル）または Vercel の Environment Variables に設定し、
# このファイルやGitには秘密の値を書かないでください。
# ============================================================

# --- 必須 ---------------------------------------------------
# PostgreSQL（Supabase等）。接続プーラー経由のURLを推奨
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# マイグレーション用（直結URL。未設定なら DATABASE_URL を使用）
MIGRATE_DATABASE_URL=
# 公開URL（招待リンク・メール・LINEのコールバックに使用。末尾の / なし）
APP_URL=http://localhost:3000
# 署名用の秘密値（32文字以上のランダムな文字列。openssl rand -base64 48 などで作成）
APP_SECRET=
# 定期処理（/api/cron）の認証用。Vercel Cron は Authorization: Bearer <CRON_SECRET> を送る
CRON_SECRET=

# --- Slack（docs/SLACK.md） -----------------------------------
# 毎日の要約の投稿先（Slack アプリの Incoming Webhook。https://hooks.slack.com/ で始まる）
SLACK_WEBHOOK_URL=
# /ai コマンドの署名検証用（Slack アプリの Basic Information → Signing Secret）
SLACK_SIGNING_SECRET=
# /ai を使える人を限定する場合の Slack ユーザーID（カンマ区切り。空なら全員）
SLACK_ALLOWED_USER_IDS=
# Claude（Claude Code の定期タスク）の API 起動URLとトークン（claude.ai/code の定期タスク画面で発行）
ROUTINE_FIRE_URL=
ROUTINE_FIRE_TOKEN=

# --- ファイル保存（領収書・日報添付・契約書） -------------------
# local（開発用・サーバーのディスク） / supabase（本番推奨・非公開バケット）
STORAGE_DRIVER=local
STORAGE_DIR=./.data/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-files

# --- メール（稼働希望のリマインド・招待・メール確認） -------------
# console（送信せず履歴のみ） / smtp / resend
EMAIL_DRIVER=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# 送信先の制限（カンマ区切り。テスト中に実在の人へ送らないため。空なら制限なし）
EMAIL_ALLOWLIST=

# --- LINE Login（ドライバーのログイン。メッセージ送信は使わない） ---
# LINE Developers で「LINEログイン」チャネルを作成し、コールバックURLに
# {APP_URL}/api/auth/line/callback を登録
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# --- AI文章（任意。未設定でも動作し、ルールベースの文章を表示） ------
ANTHROPIC_API_KEY=
LLM_MODEL=
# off にするとAPIキーがあってもLLMを使わない
LLM_DRIVER=

# --- デモ ---------------------------------------------------
# 開発環境でパスワードなしの「デモログイン」を使う
DEMO_LOGIN=false
# 本番ビルドでデモログインを使うのは、架空データだけの「デモ環境」を公開する場合のみ。
# 実データの本番では絶対に true にしないでください（デモ用アカウント @demo.invalid 以外は拒否されます）
DEMO_ENVIRONMENT=false
# 本番ビルドの環境でデモデータを投入する場合のみ yes（デモ専用DBに限る）
DEMO_SEED_ALLOW=

# --- その他 -------------------------------------------------
# ログイン試行制限でIPを判定するヘッダー（Vercel: x-forwarded-for）
TRUSTED_IP_HEADER=
# 最初の経営者アカウント作成時のみ（pnpm admin:create）。作成後は削除
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
# テスト用DB（本番・開発DBと別にする）
TEST_DATABASE_URL=
E2E_DATABASE_URL=
